{
  // Расширяем основной конфиг приложения или проекта
  // Убедись, что путь верный (может быть tsconfig.json или tsconfig.app.json)
  "extends": "./tsconfig.json",
  "include": [
    // Включаем все TS/JS файлы в директории и поддиректориях
    "**/*.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.cjs",
    // Можно добавить специфичные файлы, если они не попадают под паттерны выше
     "jest.config.ts",
     "webpack.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
    // Добавь другие исключения, если нужно
  ]
} 