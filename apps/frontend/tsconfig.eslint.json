{
  // Расширяем основной конфиг приложения или проекта
  // Убедись, что путь верный (может быть tsconfig.json или tsconfig.app.json)
  "extends": "./tsconfig.json",
  "include": [
    // Включаем все TS/JS/JSX файлы в директории и поддиректориях
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    // Можно добавить специфичные файлы, если они не попадают под паттерны выше
    "jest.config.ts",
    "webpack.config.js",
    ".babelrc", // Включим и Babel конфиг, если он важен для парсинга
    "tailwind.config.js",
    "postcss.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
    // Добавь другие исключения, если нужно
  ]
} 